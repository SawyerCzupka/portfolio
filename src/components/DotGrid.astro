---
interface Props {
  rows?: number;
  cols?: number;
  gap?: number;
  r?: number;
  class?: string;
}

const { rows = 6, cols = 8, gap = 16, r = 1.2, class: className = '' } = Astro.props;
const width = cols * gap;
const height = rows * gap;
const dots = Array.from({ length: rows * cols }, (_, i) => ({
  cx: (i % cols) * gap + gap / 2,
  cy: Math.floor(i / cols) * gap + gap / 2,
}));
---

<svg
  class={className}
  width={width}
  height={height}
  viewBox={`0 0 ${width} ${height}`}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {dots.map((d) => (
    <circle cx={d.cx} cy={d.cy} r={r} fill="currentColor" />
  ))}
</svg>
