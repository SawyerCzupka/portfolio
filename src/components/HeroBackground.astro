---
// Technical-drawing figure for the hero: dot grid, framed sheet with
// dimension lines, and a slowly rotating reticle at the center.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

const W = 400;
const H = 400;
const PAD = 40;
const GAP = 20;

const dots = [];
for (let x = PAD; x <= W - PAD; x += GAP) {
  for (let y = PAD; y <= H - PAD; y += GAP) dots.push({ x, y });
}

const CX = W / 2;
const CY = H / 2;
const TICK = 14;
const corners = [
  [PAD, PAD, 1, 1],
  [W - PAD, PAD, -1, 1],
  [PAD, H - PAD, 1, -1],
  [W - PAD, H - PAD, -1, -1],
] as const;
---

<svg
  data-island="bare"
  class={className}
  width={W}
  height={H + 28}
  viewBox={`0 0 ${W} ${H + 28}`}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <g class="text-faint" opacity="0.55">
    {dots.map((d) => <circle cx={d.x} cy={d.y} r="1" fill="currentColor" />)}
  </g>

  <g class="text-border-strong" stroke="currentColor">
    <rect x={PAD} y={PAD} width={W - PAD * 2} height={H - PAD * 2} stroke-width="1" />
    <line x1={PAD} y1={CY} x2={W - PAD} y2={CY} stroke-width="0.5" stroke-dasharray="2 4" />
    <line x1={CX} y1={PAD} x2={CX} y2={H - PAD} stroke-width="0.5" stroke-dasharray="2 4" />
  </g>

  <g class="text-muted" stroke="currentColor" stroke-width="1.25">
    {
      corners.map(([x, y, dx, dy]) => (
        <path d={`M${x} ${y + dy * TICK}V${y}H${x + dx * TICK}`} />
      ))
    }
  </g>

  {/* Dimension lines */}
  <g class="text-faint" stroke="currentColor" stroke-width="0.75">
    <line x1={PAD} y1={H - 14} x2={W - PAD} y2={H - 14} />
    <line x1={PAD} y1={H - 20} x2={PAD} y2={H - 8} />
    <line x1={W - PAD} y1={H - 20} x2={W - PAD} y2={H - 8} />
    <line x1={W - 14} y1={PAD} x2={W - 14} y2={H - PAD} />
    <line x1={W - 20} y1={PAD} x2={W - 8} y2={PAD} />
    <line x1={W - 20} y1={H - PAD} x2={W - 8} y2={H - PAD} />
  </g>
  <g class="text-faint font-mono" fill="currentColor" font-size="9" letter-spacing="0.5">
    <rect x={CX - 26} y={H - 20} width="52" height="12" class="fill-bg" />
    <text x={CX} y={H - 11} text-anchor="middle">320.00</text>
    <text x="0" y={H + 22}>FIG. 01</text>
    <text x={W} y={H + 22} text-anchor="end">SCALE 1:1</text>
  </g>

  {/* Reticle */}
  <g class="text-accent" stroke="currentColor">
    <circle cx={CX} cy={CY} r="44" stroke-width="0.75" opacity="0.35" />
    <g class="reticle" style={`transform-origin: ${CX}px ${CY}px`}>
      <circle cx={CX} cy={CY} r="60" stroke-width="0.75" stroke-dasharray="1 9" opacity="0.8" />
      <line x1={CX} y1={CY - 66} x2={CX} y2={CY - 54} stroke-width="1.25" />
    </g>
    <circle cx={CX} cy={CY} r="4" stroke-width="1" />
    <circle cx={CX} cy={CY} r="1.25" fill="currentColor" stroke="none" />
  </g>
</svg>

<style>
  .reticle {
    animation: spin 40s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
