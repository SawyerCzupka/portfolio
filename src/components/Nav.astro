---
const navLinks = [
  { href: '/', label: 'home' },
  { href: '/writing', label: 'writing' },
  { href: '/projects', label: 'projects' },
  { href: '/resume', label: 'resume' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="border-b border-border sticky top-0 z-50 bg-bg/95 backdrop-blur-sm">
  <nav class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
    <a
      href="/"
      class="font-sans font-semibold text-sm tracking-wide text-text hover:text-accent transition-colors duration-150"
    >
      SAWYER CZUPKA
    </a>

    <ul class="flex items-center gap-6" role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class={`font-mono text-xs tracking-wider transition-colors duration-150 ${
              isActive(link.href)
                ? 'text-accent'
                : 'text-muted hover:text-text'
            }`}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
