---
// Technical coordinate-cross accent — precise, minimal, engineering-flavored.
interface Props {
  class?: string;
  variant?: 'cross' | 'corner' | 'bracket';
}

const { class: className = '', variant = 'cross' } = Astro.props;
---

{variant === 'cross' && (
  <svg
    class={className}
    width="96"
    height="96"
    viewBox="0 0 96 96"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    {/* Full axis lines */}
    <line x1="0" y1="48" x2="96" y2="48" stroke="currentColor" stroke-width="0.6" />
    <line x1="48" y1="0" x2="48" y2="96" stroke="currentColor" stroke-width="0.6" />
    {/* Center circle */}
    <circle cx="48" cy="48" r="3.5" fill="none" stroke="currentColor" stroke-width="0.6" />
    {/* Tick marks at 1/4 intervals */}
    <line x1="24" y1="44" x2="24" y2="52" stroke="currentColor" stroke-width="0.6" />
    <line x1="72" y1="44" x2="72" y2="52" stroke="currentColor" stroke-width="0.6" />
    <line x1="44" y1="24" x2="52" y2="24" stroke="currentColor" stroke-width="0.6" />
    <line x1="44" y1="72" x2="52" y2="72" stroke="currentColor" stroke-width="0.6" />
    {/* Coordinate labels — stylized */}
    <line x1="80" y1="46" x2="80" y2="50" stroke="currentColor" stroke-width="0.6" opacity="0.5" />
    <line x1="16" y1="46" x2="16" y2="50" stroke="currentColor" stroke-width="0.6" opacity="0.5" />
  </svg>
)}

{variant === 'corner' && (
  <svg
    class={className}
    width="48"
    height="48"
    viewBox="0 0 48 48"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    {/* Corner bracket marks */}
    <line x1="0" y1="12" x2="12" y2="12" stroke="currentColor" stroke-width="0.75" />
    <line x1="12" y1="0" x2="12" y2="12" stroke="currentColor" stroke-width="0.75" />
    <line x1="36" y1="0" x2="36" y2="12" stroke="currentColor" stroke-width="0.75" />
    <line x1="36" y1="12" x2="48" y2="12" stroke="currentColor" stroke-width="0.75" />
    <line x1="0" y1="36" x2="12" y2="36" stroke="currentColor" stroke-width="0.75" />
    <line x1="12" y1="36" x2="12" y2="48" stroke="currentColor" stroke-width="0.75" />
    <line x1="36" y1="36" x2="36" y2="48" stroke="currentColor" stroke-width="0.75" />
    <line x1="36" y1="36" x2="48" y2="36" stroke="currentColor" stroke-width="0.75" />
    {/* Center dot */}
    <circle cx="24" cy="24" r="1.5" fill="currentColor" opacity="0.4" />
  </svg>
)}

{variant === 'bracket' && (
  <svg
    class={className}
    width="16"
    height="24"
    viewBox="0 0 16 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <line x1="8" y1="0" x2="8" y2="24" stroke="currentColor" stroke-width="0.75" />
    <line x1="8" y1="0" x2="16" y2="0" stroke="currentColor" stroke-width="0.75" />
    <line x1="8" y1="24" x2="16" y2="24" stroke="currentColor" stroke-width="0.75" />
  </svg>
)}
