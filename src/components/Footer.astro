---
import { Mail, Linkedin, Github } from '@lucide/astro';

const year = new Date().getFullYear();

const links = [
  {
    href: 'mailto:sawyerczupka@gmail.com',
    label: 'email',
    icon: Mail,
    external: false,
  },
  {
    href: 'https://linkedin.com/in/sawyerczupka',
    label: 'linkedin',
    icon: Linkedin,
    external: true,
  },
  {
    href: 'https://github.com/sawyerczupka',
    label: 'github',
    icon: Github,
    external: true,
  },
];
---

<footer class="border-t border-border mt-24">
  <div class="max-w-5xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <span class="font-mono text-xs text-faint tracking-wider">
      © {year} SAWYER CZUPKA
    </span>
    <ul class="flex items-center gap-5" role="list">
      {links.map(({ href, label, icon: Icon, external }) => (
        <li>
          <a
            href={href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
            aria-label={label}
            class="flex items-center gap-1.5 font-mono text-xs text-muted hover:text-accent transition-colors duration-150 tracking-wider group"
          >
            <Icon size={14} class="shrink-0" />
            <span class="hidden sm:inline">{label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
