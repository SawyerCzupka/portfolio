---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { getProjects } from "@/lib/projects";

// Fine dot grid — 34 cols × 8 rows at 28px, full-width backdrop
const COLS = 34;
const ROWS = 8;
const GAP = 28;
const gridDots = Array.from({ length: COLS * ROWS }, (_, i) => ({
  cx: (i % COLS) * GAP + GAP / 2,
  cy: Math.floor(i / COLS) * GAP + GAP / 2,
}));
const gridW = COLS * GAP;
const gridH = ROWS * GAP;

const skills = {
  "Programming & ML/Modeling": [
    "Python",
    "TypeScript",
    "JavaScript",
    "Java",
    "C++",
    "Rust",
    "PyTorch",
    "PyTorch Geometric",
    "Scikit-Learn",
    "Pandas",
    "Hugging Face Transformers",
    "React",
    "Vue",
    "FastAPI",
    "Django",
    "SQLAlchemy",
    "PostgreSQL",
    "TimescaleDB",
    "MongoDB",
    "Qdrant",
    "LlamaIndex",
    "DeepEval",
    "vLLM",
    "Azure OpenAI",
    "Langfuse",
    "Git",
  ],
  "DevOps & Infrastructure": [
    "Docker",
    "Kubernetes",
    "Terraform",
    "Packer",
    "ArgoCD",
    "GitHub Actions",
    "CI/CD",
    "Prometheus",
    "Grafana",
    "Traefik",
    "MLflow",
    "Azure",
    "Azure Monitor / KQL",
    "OpenTelemetry",
    "AWS",
    "AWS Lambda",
    "Linux",
    "Nginx",
    "Let's Encrypt",
  ],
};

const experience = (await getCollection("experience"))
  .map((e) => e.data)
  .sort((a, b) => b.start.valueOf() - a.start.valueOf());

const academicEntries = await getCollection("projects", (e) => e.data.academic === true);
const academicProjects = academicEntries
  .map((e) => ({ id: e.id, ...e.data }))
  .sort((a, b) => a.name.localeCompare(b.name));

const projects = (
  await getProjects((e) => e.data.resumeBullets.length > 0)
).map((e) => ({
  name: e.data.name,
  url: e.data.url,
  period: e.data.period,
  bullets: e.data.resumeBullets,
}));
---

<Base
  title="Resume — Sawyer Czupka"
  description="Resume for Sawyer Czupka — Software Engineer, ML Engineer, and DevOps / Infrastructure Engineer."
>
  <div class="max-w-5xl mx-auto px-6 py-16">
    {/* Header — background: fine dot grid spanning full width */}
    <header class="mb-12 relative overflow-hidden pb-4">
      {/* Fine, dense dot grid — fills the header horizontally */}
      <svg
        class="absolute left-0 top-0 text-faint opacity-[0.18] pointer-events-none"
        width={gridW}
        height={gridH}
        viewBox={`0 0 ${gridW} ${gridH}`}
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        {
          gridDots.map((d) => (
            <circle cx={d.cx} cy={d.cy} r="1" fill="currentColor" />
          ))
        }
      </svg>

      <div class="relative z-10">
        <p class="font-mono text-xs text-accent tracking-widest uppercase mb-4">
          // resume
        </p>
        <div
          class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6"
        >
          <div>
            <h1 class="text-4xl sm:text-5xl font-bold text-text leading-tight">
              Sawyer Czupka
            </h1>
            <div class="flex flex-wrap gap-4 mt-4">
              <a
                href="mailto:sawyerczupka@gmail.com"
                class="font-mono text-xs text-muted hover:text-accent transition-colors duration-150 tracking-wider"
              >
                sawyerczupka@gmail.com
              </a>
              <span class="text-faint font-mono text-xs">·</span>
              <a
                href="https://linkedin.com/in/sawyerczupka"
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-xs text-muted hover:text-accent transition-colors duration-150 tracking-wider"
              >
                linkedin.com/in/sawyerczupka
              </a>
            </div>
          </div>
          <div class="flex flex-col gap-2 self-start">
            <p class="font-mono text-xs text-muted tracking-widest uppercase">
              // download resume
            </p>
            <div class="flex flex-wrap gap-2">
              <a
                href="/sawyerczupka_resume_swe.pdf"
                download
                class="font-mono text-xs text-accent border border-accent px-3 py-1.5 hover:bg-accent hover:text-bg transition-colors duration-150 tracking-wide"
              >
                ↓ swe
              </a>
              <a
                href="/sawyerczupka_resume_mle.pdf"
                download
                class="font-mono text-xs text-accent border border-accent px-3 py-1.5 hover:bg-accent hover:text-bg transition-colors duration-150 tracking-wide"
              >
                ↓ ml engineer
              </a>
              <a
                href="/sawyerczupka_resume_devops.pdf"
                download
                class="font-mono text-xs text-accent border border-accent px-3 py-1.5 hover:bg-accent hover:text-bg transition-colors duration-150 tracking-wide"
              >
                ↓ devops
              </a>
            </div>
          </div>
        </div>
      </div>
    </header>

    {/* ── Skills ─────────────────────────────────────────── */}
    <section class="mb-12">
      <h2
        class="font-mono text-xs text-muted tracking-widest uppercase mb-6 pb-3 border-b border-border"
      >
        // skills
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        {
          Object.entries(skills).map(([category, items]) => (
            <div>
              <h3 class="font-mono text-xs text-accent tracking-wider mb-3 uppercase">
                {category}
              </h3>
              <div class="flex flex-wrap gap-2">
                {items.map((skill) => (
                  <span class="font-mono text-xs text-muted bg-surface-2 border border-border-strong px-2 py-1">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    {/* ── Education ──────────────────────────────────────── */}
    <section class="mb-12">
      <h2
        class="font-mono text-xs text-muted tracking-widest uppercase mb-6 pb-3 border-b border-border"
      >
        // education
      </h2>
      <div
        class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2"
      >
        <div>
          <h3 class="font-semibold text-text">College of William & Mary</h3>
          <p class="text-sm text-muted mt-1">
            BS in Computer Science & Data Science — Cum Laude & Dean's List
          </p>
        </div>
        <div class="text-right shrink-0">
          <span class="font-mono text-xs text-faint tracking-wider block"
            >Sept 2021 – May 2025</span
          >
          <span class="font-mono text-xs text-accent tracking-wider block mt-1"
            >GPA: 3.6</span
          >
        </div>
      </div>
    </section>

    {/* ── Experience ─────────────────────────────────────── */}
    <section class="mb-12">
      <h2
        class="font-mono text-xs text-muted tracking-widest uppercase mb-6 pb-3 border-b border-border"
      >
        // experience
      </h2>
      <div class="space-y-10">
        {
          experience.map((job) => (
            <article>
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-4">
                <div>
                  <h3 class="font-semibold text-text">{job.title}</h3>
                  <p class="text-sm text-accent mt-0.5">{job.org}</p>
                </div>
                <span class="font-mono text-xs text-faint tracking-wider shrink-0">
                  {job.period}
                </span>
              </div>
              <ul class="space-y-2.5" role="list">
                {job.bullets.map((b) => (
                  <li class="flex gap-3 text-sm text-muted leading-relaxed">
                    <span class="text-faint shrink-0 font-mono mt-0.5">—</span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    {/* ── Projects ───────────────────────────────────────── */}
    <section class="mb-12">
      <h2
        class="font-mono text-xs text-muted tracking-widest uppercase mb-6 pb-3 border-b border-border"
      >
        // personal projects
      </h2>
      <div class="space-y-8">
        {
          projects.map((proj) => (
            <article>
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-4">
                <h3 class="font-semibold text-text">
                  {proj.url ? (
                    <a
                      href={proj.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:text-accent transition-colors duration-150"
                    >
                      {proj.name}
                      <span class="font-mono text-xs text-faint ml-2">↗</span>
                    </a>
                  ) : (
                    proj.name
                  )}
                </h3>
                <span class="font-mono text-xs text-faint tracking-wider shrink-0">
                  {proj.period}
                </span>
              </div>
              <ul class="space-y-2.5" role="list">
                {proj.bullets.map((b) => (
                  <li class="flex gap-3 text-sm text-muted leading-relaxed">
                    <span class="text-faint shrink-0 font-mono mt-0.5">—</span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    {/* ── Academic Projects ──────────────────────────────── */}
    <section class="mt-12">
      <h2
        class="font-mono text-xs text-muted tracking-widest uppercase mb-6 pb-3 border-b border-border"
      >
        // academic projects
      </h2>
      <div class="space-y-6">
        {
          academicProjects.map((proj) => (
            <article>
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1">
                <h3 class="font-semibold text-text text-sm">{proj.name}</h3>
                <span class="font-mono text-xs text-faint tracking-wider shrink-0">
                  {proj.period}
                </span>
              </div>
              <p class="text-sm text-muted leading-relaxed">{proj.teaser}</p>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</Base>
