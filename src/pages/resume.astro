---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { getProjects } from "@/lib/projects";
import { getExperience } from "@/lib/experience";

const skills = {
  Languages: ["Python", "TypeScript", "JavaScript", "Java", "C++", "Rust"],
  "Web & data": [
    "FastAPI",
    "Django",
    "SQLAlchemy",
    "PostgreSQL",
    "TimescaleDB",
    "MongoDB",
    "React",
    "Vue",
  ],
  "ML & LLMs": [
    "PyTorch",
    "PyTorch Geometric",
    "Scikit-Learn",
    "Pandas",
    "Hugging Face Transformers",
    "Qdrant",
    "LlamaIndex",
    "vLLM",
    "DeepEval",
    "Langfuse",
    "Azure OpenAI",
  ],
  Infrastructure: [
    "Azure",
    "AWS",
    "Kubernetes",
    "Docker",
    "Terraform",
    "Packer",
    "ArgoCD",
    "GitHub Actions",
    "Traefik",
    "Nginx",
    "Linux",
  ],
  Observability: ["Azure Monitor / KQL", "OpenTelemetry", "Prometheus", "Grafana", "MLflow"],
};

const experience = await getExperience();

const projects = (await getProjects((e) => e.data.resumeBullets.length > 0)).map((e) => ({
  name: e.data.name,
  url: e.data.url,
  period: e.data.period,
  bullets: e.data.resumeBullets,
}));

const academicProjects = (await getProjects((e) => e.data.academic)).map((e) => e.data);

const downloads = [
  { href: "/sawyerczupka_resume_swe.pdf", label: "software engineer" },
  { href: "/sawyerczupka_resume_mle.pdf", label: "ml engineer" },
  { href: "/sawyerczupka_resume_devops.pdf", label: "devops" },
];

const sections = [
  { id: "experience", label: "Experience" },
  { id: "projects", label: "Projects" },
  { id: "skills", label: "Skills" },
  { id: "education", label: "Education" },
];
---

<Base
  title="Resume — Sawyer Czupka"
  sheet="03 — resume"
  description="Resume for Sawyer Czupka — Software Engineer, ML Engineer, and DevOps / Infrastructure Engineer."
>
  <div class="max-w-5xl mx-auto px-6">
    <PageHeader sheet="03" title="Resume">
      <div class="font-mono text-xs space-y-1.5 sm:text-right">
        <a href="mailto:sawyerczupka@gmail.com" class="link-draw block w-fit sm:ml-auto text-text hover:text-accent pb-0.5">
          sawyerczupka@gmail.com
        </a>
        <a
          href="https://linkedin.com/in/sawyerczupka"
          target="_blank"
          rel="noopener noreferrer"
          class="link-draw block w-fit sm:ml-auto text-muted hover:text-accent pb-0.5"
        >
          linkedin.com/in/sawyerczupka ↗
        </a>
      </div>
    </PageHeader>

    <div class="grid gap-12 lg:grid-cols-[11rem_1fr] pt-12">
      <aside class="lg:sticky lg:top-28 self-start font-mono text-xs">
        <nav class="hidden lg:block mb-10" aria-label="Resume sections">
          <ol class="space-y-2.5" role="list">
            {
              sections.map((s, i) => (
                <li>
                  <a href={`#${s.id}`} class="group flex gap-3 text-muted hover:text-text">
                    <span class="text-faint group-hover:text-accent">0{i + 1}</span>
                    {s.label.toLowerCase()}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
        <p class="uppercase text-[11px] tracking-wide text-faint mb-3">download pdf</p>
        <ul class="flex flex-wrap lg:flex-col gap-2" role="list">
          {
            downloads.map((d) => (
              <li>
                <a
                  href={d.href}
                  download
                  class="inline-flex items-center gap-2 border border-border-strong px-3 py-1.5 text-muted hover:border-accent hover:text-accent transition-colors duration-150"
                >
                  ↓ {d.label}
                </a>
              </li>
            ))
          }
        </ul>
      </aside>

      <div class="min-w-0 space-y-24">
        <section id="experience" class="scroll-mt-24">
          <SectionHeading index="01" title="Experience" />
          <ol class="relative border-l border-border-strong ml-1" role="list">
            {
              experience.map((job) => (
                <li class="relative pl-8 pb-12 last:pb-0">
                  <span
                    class:list={[
                      "absolute -left-[5px] top-1.5 size-[9px] border",
                      job.current ? "bg-accent border-accent" : "bg-bg border-border-strong",
                    ]}
                  />
                  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-4">
                    <div>
                      <h3 class="font-serif text-2xl leading-tight text-text">{job.title}</h3>
                      <p class="text-sm text-accent mt-1">
                        {job.url ? (
                          <a href={job.url} target="_blank" rel="noopener noreferrer" class="link-draw pb-0.5">
                            {job.org} ↗
                          </a>
                        ) : (
                          job.org
                        )}
                      </p>
                    </div>
                    <span class="font-mono text-xs text-faint shrink-0">{job.period}</span>
                  </div>
                  <ul class="space-y-2.5" role="list">
                    {job.bullets.map((b) => (
                      <li class="grid grid-cols-[1.25rem_1fr] text-sm text-muted leading-relaxed">
                        <span class="text-faint font-mono">–</span>
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ol>
        </section>

        <section id="projects" class="scroll-mt-24">
          <SectionHeading index="02" title="Projects" />
          <div class="space-y-10">
            {
              projects.map((proj) => (
                <article>
                  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-4">
                    <h3 class="font-serif text-2xl leading-tight text-text">
                      {proj.url ? (
                        <a href={proj.url} target="_blank" rel="noopener noreferrer" class="link-draw hover:text-accent">
                          {proj.name} <span class="font-mono text-xs text-faint">↗</span>
                        </a>
                      ) : (
                        proj.name
                      )}
                    </h3>
                    <span class="font-mono text-xs text-faint shrink-0">{proj.period}</span>
                  </div>
                  <ul class="space-y-2.5" role="list">
                    {proj.bullets.map((b) => (
                      <li class="grid grid-cols-[1.25rem_1fr] text-sm text-muted leading-relaxed">
                        <span class="text-faint font-mono">–</span>
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
          <p class="mt-10 text-sm text-muted">
            Coursework: {academicProjects.map((p) => p.name).join(" · ")}.{" "}
            <a href="/projects" class="link-draw text-text hover:text-accent pb-0.5">Details →</a>
          </p>
        </section>

        <section id="skills" class="scroll-mt-24">
          <SectionHeading index="03" title="Skills" />
          <dl class="divide-y divide-border border-y border-border">
            {
              Object.entries(skills).map(([category, items]) => (
                <div class="grid sm:grid-cols-[10rem_1fr] gap-2 py-4">
                  <dt class="font-mono text-[11px] uppercase tracking-wide text-faint pt-0.5">{category}</dt>
                  <dd class="text-sm text-text leading-relaxed">{items.join(" · ")}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section id="education" class="scroll-mt-24">
          <SectionHeading index="04" title="Education" />
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2">
            <div>
              <h3 class="font-serif text-2xl leading-tight text-text">College of William &amp; Mary</h3>
              <p class="text-sm text-muted mt-1">
                BS in Computer Science &amp; Data Science — Cum Laude, Dean's List
              </p>
            </div>
            <div class="font-mono text-xs sm:text-right shrink-0">
              <span class="text-faint block">Sept 2021 – May 2025</span>
              <span class="text-accent block mt-1">GPA 3.6</span>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</Base>
