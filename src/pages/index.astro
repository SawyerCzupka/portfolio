---
import Base from "../layouts/Base.astro";
import HeroBackground from "../components/HeroBackground.astro";
import { getCollection } from "astro:content";
import PostList from "@/components/PostList.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base title="Sawyer Czupka">
  {/* ── Hero ─────────────────────────────────────────────── */}
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-36 relative overflow-hidden">
    {/* Background: large dot grid + geometric composition, right half */}
    <HeroBackground
      class="hidden lg:block absolute right-[-24px] top-[-16px] text-faint opacity-[0.22] pointer-events-none"
    />

    {/* Content floats above the background */}
    <div class="relative z-10 max-w-xl">
      <p class="font-mono text-xs text-accent tracking-widest mb-6 uppercase">
        // portfolio
      </p>

      <h1
        class="text-5xl sm:text-6xl font-bold leading-none tracking-tight text-text mb-4"
      >
        Sawyer Czupka
      </h1>

      <div class="flex items-center gap-3 mb-6">
        <div class="h-px w-12 bg-accent shrink-0"></div>
        <div class="h-px w-32 bg-border-strong"></div>
      </div>

      <p class="text-xl sm:text-2xl font-medium text-muted leading-snug mb-6">
        Software Engineer.<br />
        ML Systems · Infrastructure · Full-stack.
      </p>

      <p class="text-base text-muted leading-relaxed mb-10">
        I build intelligent systems at the intersection of machine learning,
        backend engineering, and production infrastructure — from RAG pipelines
        and LLM evaluation frameworks to Kubernetes clusters and CI/CD
        automation. Recently finished my BS in Computer Science & Data Science
        at William & Mary, Cum Laude.
      </p>

      <div class="flex flex-wrap gap-4">
        <a
          href="/resume"
          class="font-mono text-sm text-accent border border-accent px-5 py-2.5 hover:bg-accent hover:text-bg transition-colors duration-150 tracking-wide"
        >
          → my resume
        </a>
        <a
          href="/projects"
          class="font-mono text-sm text-text border border-border-strong px-5 py-2.5 hover:border-accent hover:text-accent transition-colors duration-150 tracking-wide"
        >
          → view projects
        </a>
      </div>
    </div>
  </section>

  {/* ── Divider ──────────────────────────────────────────── */}
  <!-- <div class="max-w-5xl mx-auto px-6">
    <div class="border-t border-border"></div>
  </div>

  {/* ── Recent Writing ───────────────────────────────────── */}
  <section class="max-w-5xl mx-auto px-6 py-12">
    <div class="flex items-center justify-between mb-10">
      <h2 class="font-mono text-xs text-muted tracking-widest uppercase">
        // recent writing
      </h2>
      <a
        href="/writing"
        class="font-mono text-xs text-muted hover:text-accent transition-colors duration-150 tracking-wider"
      >
        all posts →
      </a>
    </div>

    <PostList />
  </section> -->

  {/* ── Divider ──────────────────────────────────────────── */}
  <div class="max-w-5xl mx-auto px-6">
    <div class="border-t border-border"></div>
  </div>

  {/* ── Projects Teaser ──────────────────────────────────── */}
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="flex items-center justify-between mb-10">
      <h2 class="font-mono text-xs text-muted tracking-widest uppercase">
        // selected projects
      </h2>
      <a
        href="/projects"
        class="font-mono text-xs text-muted hover:text-accent transition-colors duration-150 tracking-wider"
      >
        all projects →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-border-strong">
      <a
        href="/projects#lapevo"
        class="group bg-bg p-6 hover:bg-surface transition-colors duration-150"
      >
        <div class="flex items-start justify-between mb-4">
          <h3
            class="font-semibold text-text group-hover:text-accent transition-colors duration-150"
          >
            LapEvo
          </h3>
          <span class="font-mono text-xs text-faint">2025 →</span>
        </div>
        <p class="text-sm text-muted leading-relaxed mb-4">
          iRacing telemetry tracker and AI racing coach — real-time 60Hz data
          pipeline, React dashboard, and TimescaleDB time-series storage.
        </p>
        <div class="flex flex-wrap gap-1.5">
          {
            ["Python", "FastAPI", "React", "TimescaleDB"].map((t) => (
              <span class="font-mono text-xs text-muted bg-surface-2 border border-border-strong px-2 py-0.5">
                {t}
              </span>
            ))
          }
        </div>
      </a>

      <a
        href="/projects#homelab"
        class="group bg-bg p-6 hover:bg-surface transition-colors duration-150"
      >
        <div class="flex items-start justify-between mb-4">
          <h3
            class="font-semibold text-text group-hover:text-accent transition-colors duration-150"
          >
            Homelab Infrastructure
          </h3>
          <span class="font-mono text-xs text-faint">2023 →</span>
        </div>
        <p class="text-sm text-muted leading-relaxed mb-4">
          Production-grade homelab: 116-pod Kubernetes cluster on Proxmox,
          GitOps via ArgoCD, Terraform/Packer infra-as-code, and automated TLS.
        </p>
        <div class="flex flex-wrap gap-1.5">
          {
            ["Kubernetes", "Terraform", "ArgoCD", "Proxmox"].map((t) => (
              <span class="font-mono text-xs text-muted bg-surface-2 border border-border-strong px-2 py-0.5">
                {t}
              </span>
            ))
          }
        </div>
      </a>
    </div>
  </section>
</Base>
