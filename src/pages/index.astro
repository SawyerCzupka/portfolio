---
import Base from "../layouts/Base.astro";
import HeroBackground from "../components/HeroBackground.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { getProjects } from "@/lib/projects";
import { getExperience } from "@/lib/experience";

const featuredProjects = await getProjects(({ data }) => data.featured);
const experience = await getExperience();
const current = experience.find((e) => e.current);

const spec = [
  { label: "focus", value: "Backend systems, data pipelines, infrastructure" },
  { label: "previously", value: "RAG systems · LLM evaluation · ML research at William & Mary" },
  { label: "off hours", value: "Kubernetes homelab · sim racing telemetry" },
];
---

<Base title="Sawyer Czupka">
  <section class="max-w-5xl mx-auto px-6 pt-20 sm:pt-28 pb-28">
    <div class="grid gap-16 lg:grid-cols-[1fr_auto] lg:items-center">
      <div data-island class="max-w-2xl">
        {
          current && (
            <p class="flex items-center gap-2.5 font-mono text-xs text-muted mb-10">
              <span class="relative flex size-2">
                <span class="absolute inset-0 bg-accent animate-ping opacity-60" />
                <span class="relative size-2 bg-accent" />
              </span>
              {current.title} at{" "}
              <a
                href={current.url ?? undefined}
                target="_blank"
                rel="noopener noreferrer"
                class="link-draw text-text hover:text-accent pb-0.5"
              >
                {current.org}
              </a>
            </p>
          )
        }

        <h1 class="font-serif text-7xl sm:text-8xl leading-[0.85] tracking-tight text-text mb-10">
          Sawyer<br /><em class="text-accent">Czupka</em>
        </h1>

        <p class="text-lg sm:text-xl text-muted leading-relaxed mb-12 max-w-xl">
          Backend-first software engineer. I build APIs, data pipelines, and the
          infrastructure underneath them. Right now that means connecting AI
          call-handling to the dispatch systems 911 centers run on.
        </p>

        <dl class="grid grid-cols-[6.5rem_1fr] gap-y-3 border-t border-border pt-6 mb-12 text-sm">
          {
            spec.map(({ label, value }) => (
              <>
                <dt class="font-mono text-[11px] uppercase tracking-wide text-faint pt-0.5">{label}</dt>
                <dd class="text-text">{value}</dd>
              </>
            ))
          }
        </dl>

        <div class="flex flex-wrap items-center gap-x-8 gap-y-4 font-mono text-sm">
          <a
            href="/resume"
            class="group inline-flex items-center gap-3 bg-text text-bg px-5 py-3 hover:bg-accent transition-colors duration-150"
          >
            resume
            <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
          </a>
          <a href="/projects" class="link-draw text-text hover:text-accent pb-0.5">projects →</a>
          <a
            href="https://github.com/sawyerczupka"
            target="_blank"
            rel="noopener noreferrer"
            class="link-draw text-muted hover:text-accent pb-0.5"
          >
            github ↗
          </a>
        </div>
      </div>

      <HeroBackground class="hidden lg:block w-[360px] h-auto" />
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-24">
    <SectionHeading index="01" title="Selected work" href="/projects" linkLabel="all projects" />

    <div class="grid gap-6 sm:grid-cols-2">
      {
        featuredProjects.map((project, i) => (
          <a href={`/projects#${project.id}`} data-island="bare" class="brackets group block p-8">
            <div class="flex items-baseline justify-between font-mono text-[11px] text-faint mb-8">
              <span>{String.fromCharCode(65 + i)}</span>
              <span>{project.data.period}</span>
            </div>
            <h3 class="font-serif text-3xl leading-tight text-text mb-1 group-hover:text-accent transition-colors duration-150">
              {project.data.name}
            </h3>
            <p class="font-serif italic text-muted mb-5">{project.data.subtitle}</p>
            <p class="text-sm text-muted leading-relaxed mb-8">{project.data.teaser}</p>
            <p class="font-mono text-[11px] text-faint">
              {project.data.stack.slice(0, 5).join(" / ")}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6">
    <SectionHeading index="02" title="Experience" href="/resume" linkLabel="full resume" />

    <ol data-island="bare" role="list">
      {
        experience.map((job) => (
          <li class="grid grid-cols-1 sm:grid-cols-[11rem_1fr_auto] gap-x-6 gap-y-1 py-5 border-b border-border first:border-t">
            <span class="font-mono text-xs text-faint pt-1">{job.period}</span>
            <span class="text-text">
              {job.title}
              <span class="text-muted"> — {job.org}</span>
            </span>
            {job.current && (
              <span class="hidden sm:block font-mono text-[11px] text-accent pt-1">current</span>
            )}
          </li>
        ))
      }
    </ol>
  </section>
</Base>
