---
import Base from '../layouts/Base.astro';
import DotGrid from '../components/DotGrid.astro';
import GeoAccent from '../components/GeoAccent.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base title="Sawyer Czupka">
  {/* ── Hero ─────────────────────────────────────────────── */}
  <section class="max-w-5xl mx-auto px-6 pt-20 pb-24 relative">
    {/* Geometric accents */}
    <DotGrid
      rows={5}
      cols={7}
      gap={18}
      class="absolute top-16 right-6 text-faint opacity-40 hidden sm:block"
    />
    <GeoAccent
      variant="cross"
      class="absolute bottom-8 right-32 text-faint opacity-20 hidden lg:block"
    />

    <div class="max-w-2xl">
      {/* Mono label */}
      <p class="font-mono text-xs text-accent tracking-widest mb-6 uppercase">
        // portfolio
      </p>

      {/* Name */}
      <h1 class="text-5xl sm:text-6xl font-bold leading-none tracking-tight text-text mb-4">
        Sawyer Czupka
      </h1>

      {/* Rule with accent */}
      <div class="flex items-center gap-3 mb-6">
        <div class="h-px w-12 bg-accent"></div>
        <div class="h-px flex-1 bg-border-strong"></div>
      </div>

      {/* Tagline */}
      <p class="text-xl sm:text-2xl font-medium text-muted leading-snug mb-8">
        Software Engineer.<br />
        ML Systems · Infrastructure · Full-stack.
      </p>

      {/* Bio */}
      <p class="text-base text-muted leading-relaxed max-w-xl mb-10">
        I build intelligent systems at the intersection of machine learning, backend
        engineering, and production infrastructure — from RAG pipelines and LLM evaluation
        frameworks to Kubernetes clusters and CI/CD automation. Recently finished my
        BS in Computer Science & Data Science at William & Mary, Cum Laude.
      </p>

      {/* CTAs */}
      <div class="flex flex-wrap gap-4">
        <a
          href="/writing"
          class="font-mono text-sm text-accent border border-accent px-5 py-2.5 hover:bg-accent hover:text-bg transition-colors duration-150 tracking-wide"
        >
          → read writing
        </a>
        <a
          href="/projects"
          class="font-mono text-sm text-text border border-border-strong px-5 py-2.5 hover:border-accent hover:text-accent transition-colors duration-150 tracking-wide"
        >
          → view projects
        </a>
      </div>
    </div>
  </section>

  {/* ── Divider ──────────────────────────────────────────── */}
  <div class="max-w-5xl mx-auto px-6">
    <div class="border-t border-border"></div>
  </div>

  {/* ── Recent Writing ───────────────────────────────────── */}
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="flex items-center justify-between mb-10">
      <h2 class="font-mono text-xs text-muted tracking-widest uppercase">
        // recent writing
      </h2>
      <a
        href="/writing"
        class="font-mono text-xs text-muted hover:text-accent transition-colors duration-150 tracking-wider"
      >
        all posts →
      </a>
    </div>

    <ul class="space-y-0" role="list">
      {posts.map((post) => {
        const slug = post.id.replace(/\.(md|mdx)$/, '');
        const dateStr = post.data.date.toISOString().slice(0, 10);
        return (
          <li class="border-t border-border first:border-t-0">
            <a
              href={`/writing/${slug}`}
              class="group flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-6 py-5 hover:bg-surface/50 -mx-4 px-4 transition-colors duration-150"
            >
              <time
                datetime={dateStr}
                class="font-mono text-xs text-faint tracking-wider shrink-0 pt-0.5"
              >
                {dateStr}
              </time>
              <div class="flex-1">
                <span class="text-base font-medium text-text group-hover:text-accent transition-colors duration-150">
                  {post.data.title}
                </span>
                <p class="text-sm text-muted mt-1 leading-relaxed">
                  {post.data.description}
                </p>
              </div>
              <span class="font-mono text-xs text-faint group-hover:text-accent transition-colors duration-150 shrink-0">
                →
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  {/* ── Divider ──────────────────────────────────────────── */}
  <div class="max-w-5xl mx-auto px-6">
    <div class="border-t border-border"></div>
  </div>

  {/* ── Projects Teaser ──────────────────────────────────── */}
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="flex items-center justify-between mb-10">
      <h2 class="font-mono text-xs text-muted tracking-widest uppercase">
        // selected projects
      </h2>
      <a
        href="/projects"
        class="font-mono text-xs text-muted hover:text-accent transition-colors duration-150 tracking-wider"
      >
        all projects →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-border">
      {/* LapEvo */}
      <a
        href="/projects#lapevo"
        class="group bg-bg p-6 hover:bg-surface transition-colors duration-150"
      >
        <div class="flex items-start justify-between mb-4">
          <h3 class="font-semibold text-text group-hover:text-accent transition-colors duration-150">
            LapEvo
          </h3>
          <span class="font-mono text-xs text-faint">2025 →</span>
        </div>
        <p class="text-sm text-muted leading-relaxed mb-4">
          iRacing telemetry tracker and AI racing coach — real-time 60Hz data pipeline,
          React dashboard, and TimescaleDB time-series storage.
        </p>
        <div class="flex flex-wrap gap-1.5">
          {['Python', 'FastAPI', 'React', 'TimescaleDB'].map((t) => (
            <span class="font-mono text-xs text-faint border border-border px-1.5 py-0.5">{t}</span>
          ))}
        </div>
      </a>

      {/* Homelab */}
      <a
        href="/projects#homelab"
        class="group bg-bg p-6 hover:bg-surface transition-colors duration-150"
      >
        <div class="flex items-start justify-between mb-4">
          <h3 class="font-semibold text-text group-hover:text-accent transition-colors duration-150">
            Homelab Infrastructure
          </h3>
          <span class="font-mono text-xs text-faint">2023 →</span>
        </div>
        <p class="text-sm text-muted leading-relaxed mb-4">
          Production-grade homelab: 116-pod Kubernetes cluster on Proxmox, GitOps via
          ArgoCD, Terraform/Packer infra-as-code, and automated TLS.
        </p>
        <div class="flex flex-wrap gap-1.5">
          {['Kubernetes', 'Terraform', 'ArgoCD', 'Proxmox'].map((t) => (
            <span class="font-mono text-xs text-faint border border-border px-1.5 py-0.5">{t}</span>
          ))}
        </div>
      </a>
    </div>
  </section>
</Base>
